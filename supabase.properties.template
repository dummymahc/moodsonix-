# ─────────────────────────────────────────────────────────────────────────────
# Moodsonix · Supabase Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to  local.properties  in the PROJECT ROOT.
# 2. Fill in your actual Supabase Project URL and anon (public) key.
#    You can find both in:  Supabase Dashboard → Project Settings → API
# 3. NEVER commit local.properties — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase Project URL (e.g. https://abcdefgh.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / public key (safe to expose in client apps; RLS restricts access)
SUPABASE_ANON_KEY=your-anon-key-here
